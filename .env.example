# Copy to .env; every value here is a development default, not a secret.

POSTGRES_PASSWORD=gallery

# The hash below is PBKDF2("dev-password") and is deliberately committed so
# `docker compose up` works out of the box. Single quotes matter: without them
# Compose treats the '$' separators as variable references.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-password
ADMIN_PASSWORD_HASH='pbkdf2-sha256$210000$+LX3VD2/+iGgrEAwainjZQ==$rmMhF9wXKicweukQd059EySXH+A5nt5AXcJqE/obO2Y='

# Must be at least 32 bytes for HS256.
AUTH_SIGNING_KEY=dev-only-signing-key-change-me-32bytes

PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_EVENTS_URL=http://localhost:8081
IMAGE_BASE_URL=http://localhost:8333
