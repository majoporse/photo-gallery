{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "photo-gallery chart values",
  "description": "Required deployment values for the Photo Gallery application chart.",
  "type": "object",
  "required": [
    "image",
    "ingress",
    "secrets"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Overrides the chart name in app.kubernetes.io/name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Overrides the release-derived base resource name."
    },
    "image": {
      "type": "object",
      "required": [
        "api",
        "web"
      ],
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "api": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
              "not": {
                "enum": [
                  "latest"
                ]
              },
              "description": "Immutable image tag. The placeholder __required__ is rejected by templates/validation.yaml."
            }
          }
        },
        "web": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
              "not": {
                "enum": [
                  "latest"
                ]
              },
              "description": "Immutable image tag. The placeholder __required__ is rejected by templates/validation.yaml."
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPath": {
          "type": "string",
          "pattern": "^/.*"
        },
        "publicSiteUrl": {
          "type": "string",
          "description": "Empty derives https://<ingress.siteHost>."
        },
        "imageBaseUrl": {
          "type": "string",
          "description": "Empty derives https://<image host>."
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "podAntiAffinity": {
      "type": "string",
      "enum": [
        "preferred",
        "required"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "storageEndpoint": {
          "type": "string",
          "minLength": 1
        },
        "storagePublicBucket": {
          "type": "string",
          "minLength": 1
        },
        "storagePrivateBucket": {
          "type": "string",
          "minLength": 1
        },
        "storageForcePathStyle": {
          "type": "boolean"
        },
        "authIssuer": {
          "type": "string",
          "minLength": 1
        },
        "authAudience": {
          "type": "string",
          "minLength": 1
        },
        "corsAllowedOrigin": {
          "type": "string",
          "description": "Empty derives https://<ingress.siteHost>."
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Name of an existing Secret in the release namespace. The chart never creates it."
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "siteHost",
        "apiHost"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "siteHost": {
          "anyOf": [
            {
              "const": "__required__"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Public site hostname. The placeholder __required__ is rejected by templates/validation.yaml."
        },
        "apiHost": {
          "anyOf": [
            {
              "const": "__required__"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Public API hostname. The placeholder __required__ is rejected by templates/validation.yaml."
        },
        "imageHost": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Empty derives img.<siteHost>. Owned by the platform ingress, not this chart."
        },
        "certManager": {
          "type": "object",
          "required": [
            "clusterIssuer"
          ],
          "properties": {
            "clusterIssuer": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
