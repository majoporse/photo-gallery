{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "photo-gallery chart values",
  "description": "Deployment values for the Photo Gallery chart (app + platform).",
  "type": "object",
  "required": [
    "image",
    "ingress",
    "secrets"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "api",
        "web"
      ],
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "api": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
              "not": {
                "enum": [
                  "latest"
                ]
              },
              "description": "Immutable image tag. The placeholder __required__ is rejected by templates/validation.yaml."
            }
          }
        },
        "web": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
              "not": {
                "enum": [
                  "latest"
                ]
              },
              "description": "Immutable image tag. The placeholder __required__ is rejected by templates/validation.yaml."
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "notifier": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1,
          "description": "Exactly one: the notifier consumes the status queue."
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "podAntiAffinity": {
      "type": "string",
      "enum": [
        "preferred",
        "required"
      ]
    },
    "secrets": {
      "type": "object",
      "required": [
        "app",
        "postgres",
        "storage"
      ],
      "properties": {
        "registry": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "description": "Both registry values set: the chart creates photo-gallery-registry."
            },
            "password": {
              "type": "string"
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "secretName"
          ]
        },
        "app": {
          "type": "object",
          "required": [
            "secretName",
            "admin"
          ],
          "properties": {
            "signingKey": {
              "type": "string",
              "description": "At least 32 characters when set. Empty generates one on first install; reused on upgrade."
            },
            "admin": {
              "type": "object",
              "required": [
                "username",
                "passwordHash"
              ],
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordHash": {
                  "type": "string",
                  "minLength": 1,
                  "description": "PBKDF2 or Argon2 hash. The placeholder __required__ is rejected by templates/validation.yaml."
                }
              }
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postgres": {
          "type": "object",
          "required": [
            "secretName",
            "username",
            "database"
          ],
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "description": "CNPG initdb owner and DSN user."
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "CNPG initdb database."
            },
            "password": {
              "type": "string",
              "description": "Owner password. Empty generates one on first install; reused on upgrade."
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "required": [
            "secretName",
            "identity"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "description": "SeaweedFS IAM user the API/worker authenticate as."
            },
            "accessKey": {
              "type": "string",
              "description": "Set both keys to choose them; empty lets the operator generate a pair."
            },
            "secretKey": {
              "type": "string"
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storage": {
              "type": "string",
              "minLength": 1
            },
            "connectionString": {
              "type": "string",
              "description": "Overrides the composed DSN; required when enabled=false."
            }
          }
        },
        "seaweedfs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "type": "string",
              "minLength": 1
            },
            "maxVolumeCounts": {
              "type": "integer",
              "minimum": 1,
              "description": "Free volume slots per volume server. Each bucket is grown in a batch of 7, so leave room for every bucket."
            }
          }
        },
        "certManager": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "ACME email; required only when create=true."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ClusterIssuer resource name; the ingress annotations and ACME account secret follow it."
                },
                "create": {
                  "type": "boolean",
                  "description": "Create the ClusterIssuer. Default false: use the existing one."
                }
              }
            }
          }
        },
        "imageIngress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "storageEndpoint": {
          "type": "string",
          "description": "Empty derives http://seaweed-s3:8333. Required when platform.seaweedfs.enabled=false."
        },
        "storagePublicBucket": {
          "type": "string",
          "minLength": 1,
          "description": "Public derivatives bucket; also the Bucket CR name and image path."
        },
        "storagePrivateBucket": {
          "type": "string",
          "minLength": 1,
          "description": "Private originals bucket; also the Bucket CR name and image path."
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "siteHost",
        "apiHost"
      ],
      "properties": {
        "siteHost": {
          "anyOf": [
            {
              "const": "__required__"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Public site hostname. The placeholder __required__ is rejected by templates/validation.yaml."
        },
        "apiHost": {
          "anyOf": [
            {
              "const": "__required__"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Public API hostname. The placeholder __required__ is rejected by templates/validation.yaml."
        },
        "imageHost": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          ],
          "description": "Empty derives img.<siteHost>."
        }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
