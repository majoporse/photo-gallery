<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Gallery.Api</RootNamespace>
    <!-- Build-time OpenAPI export. The file is committed; CI fails when it drifts. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gallery.Application/Gallery.Application.csproj" />
    <ProjectReference Include="../Gallery.Infrastructure/Gallery.Infrastructure.csproj" />
    <ProjectReference Include="../../contracts/Gallery.Contracts/Gallery.Contracts.csproj" />
    <ProjectReference Include="../../common/Gallery.Policy/Gallery.Policy.csproj" />
  </ItemGroup>

</Project>
