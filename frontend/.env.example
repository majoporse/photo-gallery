# Copy to `.env` when you need to override the built-in local defaults.
# Every value below is also the code default in `app/lib/env.server.ts`, so the
# app runs with no .env file at all.

# Where the SSR server reaches the API (container-to-container in Compose).
API_INTERNAL_URL=http://localhost:8080

# Where the browser reaches the API and the images.
PUBLIC_API_URL=http://localhost:8080
IMAGE_BASE_URL=http://localhost:8333

# Used for canonical URLs, the sitemap and social metadata. The dev server
# also listens on this URL's port, because the API's CORS allow-list trusts it.
PUBLIC_SITE_URL=http://localhost:3000

# Serve sample data without a backend: FIXTURES=1
# FIXTURES=1
