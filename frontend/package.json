{
  "name": "photo-gallery-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run api:generate && react-router dev",
    "build": "react-router build",
    "prebuild": "npm run api:generate",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "api:generate": "orval --config orval.config.ts",
    "postinstall": "npm run api:generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "cookie": "2.0.1",
    "embla-carousel-react": "8.6.0",
    "isbot": "5.2.2",
    "lucide-react": "^1.61.0",
    "motion": "14.6.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "orval": "8.45.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
